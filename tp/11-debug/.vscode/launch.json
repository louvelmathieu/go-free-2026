{
  // Configurations de debug VS Code (extension Go, Delve en dessous).
  // Ouvrir le dossier 11-debug dans VS Code, puis F5.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "01-panic",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/01-panic"
    },
    {
      "name": "02-deadlock (cas mutex)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/02-deadlock",
      "args": ["-mutex"]
    },
    {
      "name": "03-fuite-stock (le test)",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${workspaceFolder}/03-fuite-stock"
    },
    {
      "name": "attacher à un processus",
      "type": "go",
      "request": "attach",
      "mode": "local",
      "processId": "${command:pickProcess}"
    },
    {
      "name": "distant (dlv --headless sur le serveur)",
      "type": "go",
      "request": "attach",
      "mode": "remote",
      "host": "127.0.0.1",
      "port": 2345
    }
  ]
}
